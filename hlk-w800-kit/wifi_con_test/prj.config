#
# SoC configuration
#
CONFIG_BUILD_TYPE_W800=y
# end of SoC configuration

#
# Compiler configuration
#
CONFIG_COMPILER_OPTIMIZE_LEVEL_O2=y
# end of Compiler configuration

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=1000
# CONFIG_FREERTOS_USE_TRACE_FACILITY is not set
# CONFIG_FREERTOS_ENABLE_RUN_TIME_STATS is not set
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=1
# end of FreeRTOS

#
# PERIPHERAL
#
CONFIG_COMPONENT_DRIVER_RCC_ENABLED=y
CONFIG_COMPONENT_DRIVER_GPIO_ENABLED=y
CONFIG_COMPONENT_DRIVER_UART_ENABLED=y
CONFIG_COMPONENT_DRIVER_WDT_ENABLED=y
# end of PERIPHERAL

#
# WiFi
#
CONFIG_COMPONENT_WIFI_ENABLED=y
CONFIG_WIFI_API_ENABLED=y
# end of WiFi
